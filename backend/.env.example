APP_NAME=Hybrid Search RAG
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://rag_user:rag_password@localhost:5433/rag_db

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
DENSE_RETRIEVAL_DEFAULT_TOP_K=5

BM25_DEFAULT_TOP_K=5
BM25_K1=1.5
BM25_B=0.75

HYBRID_DEFAULT_TOP_K=5
HYBRID_CANDIDATE_K=40
RRF_K=60

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_CANDIDATE_K=40
RERANKER_DEFAULT_TOP_K=10
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512

GENERATION_CONTEXT_TOP_K=10
GENERATION_CONTEXT_MAX_CHARS=30000
GENERATION_MAX_OUTPUT_TOKENS=1500
GENERATION_TEMPERATURE=0

VERIFICATION_MODEL=gemini-3.5-flash
VERIFICATION_MAX_OUTPUT_TOKENS=800

LOG_LEVEL=INFO

CHUNK_TARGET_CHARS=2800
CHUNK_OVERLAP_CHARS=400